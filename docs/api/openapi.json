  "info": {
    "description": "Local API for the COLMAP Gaussian Splatting Pipeline: create a Capture from an image set or capture video, run COLMAP structure-from-motion on CPU, and stage a Nerfstudio/gsplat-ready bundle. Every input and derived artifact is versioned in Backblaze B2. This contract documents the local API, not a hosted public endpoint.",
    "title": "COLMAP Gaussian Splatting Pipeline API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/captures": {
      "get": {
        "operationId": "list_captures_endpoint_captures_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Capture"
                  },
                  "title": "Response List Captures Endpoint Captures Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Captures Endpoint",
        "tags": [
          "captures"
        ]
      },
      "post": {
        "operationId": "create_capture_endpoint_captures_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CaptureCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Capture"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Capture Endpoint",
        "tags": [
          "captures"
        ]
      }
    },
    "/captures/stats": {
