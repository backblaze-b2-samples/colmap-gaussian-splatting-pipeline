# Backblaze B2 (required) — S3-compatible API, standardized B2_* names.
B2_APPLICATION_KEY_ID=your_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name
# Region selects the S3 endpoint (https://s3.<region>.backblazeb2.com).
B2_REGION=us-east-005

# Optional: public base URL for a public bucket, used to build direct object
# URLs (e.g. preview PNGs). Leave unset to fall back to presigned URLs.
# B2_PUBLIC_URL_BASE=https://your-bucket.s3.us-east-005.backblazeb2.com

# Optional advanced override: target a non-standard / S3-proxy endpoint.
# Leave unset to derive the endpoint from B2_REGION.
# B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com

# Example of what filled-in values look like (fake — for visual reference only):
# B2_APPLICATION_KEY_ID=00abcdef1234567000000001
# B2_APPLICATION_KEY=K000_example_application_key_value
# B2_BUCKET_NAME=my-captures-bucket
# B2_REGION=us-east-005

# Frontend → API base URL. Defaults to http://localhost:8000 for local dev;
# set this to the deployed API origin in production (Next.js inlines it at
# build time, so it must be present when `pnpm build` runs).
# NEXT_PUBLIC_API_URL=https://your-api.example.com
