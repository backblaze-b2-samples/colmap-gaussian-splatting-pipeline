{
  "name": "colmap-gaussian-splatting-pipeline",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "predev": "node scripts/doctor.mjs",
    "dev": "sh scripts/dev.sh",
    "dev:web": "pnpm --filter @colmap-gaussian-splatting-pipeline/web dev",
    "dev:api": "cd services/api && .venv/bin/uvicorn main:app --reload --port ${API_PORT:-8000}",
    "build": "pnpm --filter @colmap-gaussian-splatting-pipeline/web build",
    "typecheck": "pnpm --filter @colmap-gaussian-splatting-pipeline/web typecheck",
    "contract:export": "services/api/.venv/bin/python services/api/scripts/export_openapi.py",
    "contract:check": "services/api/.venv/bin/python services/api/scripts/export_openapi.py --check && pnpm --filter @colmap-gaussian-splatting-pipeline/web exec vitest run src/lib/api-contract.test.ts",
    "check:agent-docs": "node scripts/check-agent-docs.mjs",
    "verify": "pnpm check:agent-docs && pnpm verify:api && pnpm verify:web",
    "verify:api": "pnpm lint:api && pnpm test:api && pnpm check:structure",
    "verify:web": "pnpm lint && pnpm test:web && pnpm build",
    "verify:full": "pnpm run doctor && pnpm verify && pnpm test:e2e",
    "lint": "pnpm --filter @colmap-gaussian-splatting-pipeline/web lint",
    "lint:api": "cd services/api && .venv/bin/ruff check .",
    "test:web": "pnpm --filter @colmap-gaussian-splatting-pipeline/web test",
    "test:api": "cd services/api && .venv/bin/python -m pytest",
    "check:structure": "cd services/api && .venv/bin/python -m pytest tests/test_structure.py -v",
    "test:e2e": "pnpm --filter @colmap-gaussian-splatting-pipeline/web exec playwright test"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": "1.19.15",
      "@babel/core": "7.29.7",
      "brace-expansion@<1.1.18": "1.1.18",
      "brace-expansion@>=2.0.0 <2.1.4": "2.1.4",
      "browserslist": "4.28.8",
      "fast-uri": "3.1.2",
      "hono": "4.12.34",
      "js-yaml": "4.3.1",
      "lodash": "4.18.1",
      "nanoid": "3.3.18",
      "postcss": "8.5.23",
      "postcss-selector-parser": "7.1.3",
      "sharp": "0.35.4"
    }
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
